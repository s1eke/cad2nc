<Application x:Class="Cad2Nc.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cad2Nc.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <local:CutSideIndexConverter x:Key="CutSideIndexConverter" />
            <local:CutSideLabelConverter x:Key="CutSideLabelConverter" />
            <local:StockLabelConverter x:Key="StockLabelConverter" />
            <local:DiagnosticSeverityConverter x:Key="DiagnosticSeverityConverter" />

            <!-- Workbench layout tokens keep density consistent across the shell. -->
            <x:Double x:Key="CompactControlHeight">32</x:Double>
            <x:Double x:Key="CompactIconSize">32</x:Double>
            <CornerRadius x:Key="WorkbenchCornerRadius">2</CornerRadius>
            <Thickness x:Key="WorkbenchShellMargin">8,4,8,4</Thickness>
            <Thickness x:Key="WorkbenchPanelPadding">10</Thickness>
            <Thickness x:Key="CompactControlPadding">10,4</Thickness>

            <SolidColorBrush x:Key="CanvasSurfaceBrush" Color="#0D141F" />
            <SolidColorBrush x:Key="CanvasToolbarBrush" Color="#121D2B" />
            <SolidColorBrush x:Key="CanvasPlaybackBrush" Color="#172436" />
            <SolidColorBrush x:Key="CanvasStrokeBrush" Color="#253448" />
            <SolidColorBrush x:Key="CanvasPrimaryTextBrush" Color="#D6E8FA" />
            <SolidColorBrush x:Key="CanvasSecondaryTextBrush" Color="#91A6BE" />
            <SolidColorBrush x:Key="CanvasAccentBrush" Color="#4ABBF9" />

            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="ContextValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="PanelHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="WorkbenchPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource WorkbenchCornerRadius}" />
            </Style>
            <Style x:Key="CompactButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="{StaticResource CompactControlHeight}" />
                <Setter Property="Padding" Value="{StaticResource CompactControlPadding}" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style x:Key="CompactIconButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="{StaticResource CompactIconSize}" />
                <Setter Property="MinHeight" Value="{StaticResource CompactControlHeight}" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style x:Key="CompactToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="MinHeight" Value="{StaticResource CompactControlHeight}" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style x:Key="StatusBadgeButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="9,2" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style x:Key="CanvasToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="9,3" />
                <Setter Property="Foreground" Value="{StaticResource CanvasPrimaryTextBrush}" />
                <Setter Property="Background" Value="#172436" />
                <Setter Property="BorderBrush" Value="{StaticResource CanvasStrokeBrush}" />
            </Style>
            <Style x:Key="CanvasLegendStyle" TargetType="ToggleButton">
                <Setter Property="MinHeight" Value="28" /><Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="6,3" /><Setter Property="FontSize" Value="11" />
                <Setter Property="Background" Value="#E6121D2B" /><Setter Property="Foreground" Value="#D6E8FA" />
                <Setter Property="BorderBrush" Value="#253448" /><Setter Property="CornerRadius" Value="3" />
                <Setter Property="Template">
                    <Setter.Value><ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="LegendBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"><VisualState.Setters><Setter Target="LegendBorder.Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="LegendBorder.Opacity" Value="0.7" /><Setter Target="LegendBorder.BorderBrush" Value="#91A6BE" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="LegendBorder.Opacity" Value="0.7" /><Setter Target="LegendBorder.Background" Value="#243C51" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="LegendBorder.Opacity" Value="0.3" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="LegendBorder.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="LegendBorder.Opacity" Value="1" /><Setter Target="LegendBorder.BorderBrush" Value="#91A6BE" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="LegendBorder.Opacity" Value="1" /><Setter Target="LegendBorder.Background" Value="#243C51" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="LegendBorder.Opacity" Value="0.3" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Indeterminate"><VisualState.Setters><Setter Target="LegendBorder.Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate></Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ResultTabButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
                <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="10,4" />
            </Style>
            <Style x:Key="WorkbenchExpanderStyle" TargetType="Expander">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>
            <Style x:Key="ParameterBox" TargetType="NumberBox">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="MinHeight" Value="{StaticResource CompactControlHeight}" />
                <Setter Property="ValidationMode" Value="Disabled" />
            </Style>

            <!-- C# swaps these without moving the fixed commands. -->
            <Style x:Key="PrimaryCommandBarButtonStyle" TargetType="AppBarButton" BasedOn="{StaticResource DefaultAppBarButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Margin" Value="2,3" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
            <Style x:Key="SecondaryCommandBarButtonStyle" TargetType="AppBarButton" BasedOn="{StaticResource DefaultAppBarButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Margin" Value="2,3" />
                <Setter Property="MinHeight" Value="36" />
            </Style>

            <Style x:Key="InspectionCard" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="InspectionSuccess" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>
            <Style x:Key="InspectionError" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="InspectionNeutral" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
