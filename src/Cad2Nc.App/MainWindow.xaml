                                                            <StackPanel>
                                                                <TextBlock Text="{Binding SheetContourId}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding SuggestedFileName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding RouteCount}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="条路线" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                        <TextBlock x:Name="OutputSummaryText" TextWrapping="Wrap" />
                                        <TextBlock x:Name="OutputPathLabel" Text="默认 NC 保存位置" FontWeight="SemiBold" />
                                        <TextBlock x:Name="OutputPathText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabViewItem>
                        </TabView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Secondary pages replace the work area while the global command bar remains available. -->
        <Border
            x:Name="GuidePage"
            Grid.Row="2"
            Grid.RowSpan="3"
            Margin="{StaticResource WorkbenchShellMargin}"
            Visibility="Collapsed"
            Style="{StaticResource WorkbenchPanelStyle}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <StackPanel MaxWidth="880" Padding="24" Spacing="16" HorizontalAlignment="Center">
                    <Button
                        x:Name="GuideBackButton"
                        Content="返回工作台"
                        Click="GoWorkbench_Click"
                        HorizontalAlignment="Left"
                        Style="{StaticResource CompactButtonStyle}"
                        AutomationProperties.AutomationId="GuideBackButton" />
                    <TextBlock Text="机床与参数说明" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="ReviewProgressText"
                        Text="按需要查阅参数含义、机床适配和现场核对方法，无需逐项确认即可保存有效程序。"
                        FontSize="15"
                        TextWrapping="Wrap" />
                    <StackPanel x:Name="GuideCards" Spacing="12" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border
            x:Name="SettingsPage"
            Grid.Row="2"
            Grid.RowSpan="3"
            Margin="{StaticResource WorkbenchShellMargin}"
            Visibility="Collapsed"
            Style="{StaticResource WorkbenchPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button
                    x:Name="SettingsBackButton"
                    Margin="24,16,24,0"
                    Content="返回工作台"
                    Click="GoWorkbench_Click"
                    HorizontalAlignment="Left"
                    Style="{StaticResource CompactButtonStyle}"
                    AutomationProperties.AutomationId="SettingsBackButton" />
                <ScrollViewer
                    x:Name="SettingsScroll"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Stretch">
                    <ContentControl
                        x:Name="SettingsLayout"
                        MaxWidth="960"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Stretch"
                        IsTabStop="False"
                        AutomationProperties.AutomationId="SettingsLayout"
                        AutomationProperties.Name="设置内容"
                        AutomationProperties.AccessibilityView="Content">
                        <StackPanel x:Name="SettingsContent" Padding="24" Spacing="16" />
                    </ContentControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Only transient operation feedback and live coordinates remain here. -->
        <Grid Grid.Row="5" Padding="14,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StatusText"
                Text="就绪"
                FontSize="12"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                AutomationProperties.LiveSetting="Polite" />
            <TextBlock
                x:Name="PlaybackPositionText"
                Grid.Column="1"
                Text="位置 —"
                FontFamily="Consolas"
                FontSize="12"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Border
            x:Name="DropHighlight"
            Grid.Row="1"
            Grid.RowSpan="5"
            Margin="6"
            CornerRadius="10"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="2"
            Background="#101EA7FD"
            Visibility="Collapsed"
            IsHitTestVisible="False" />
    </Grid>
</Window>
