    <ComboBox x:Name="CutDirectionBox" Header="几何走刀方向" HorizontalAlignment="Stretch" SelectionChanged="Direction_Changed"><ComboBoxItem Content="CCW · 逆时针" /><ComboBoxItem Content="CW · 顺时针" /></ComboBox></StackPanel></Expander>
