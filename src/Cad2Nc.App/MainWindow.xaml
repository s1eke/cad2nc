<Window
    x:Class="Cad2Nc.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cad2Nc.App.Controls"
    Title="CAD2NC · 加工工作台">
    <Grid
        x:Name="Root"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        AllowDrop="True"
        DragOver="Root_DragOver"
        DragLeave="Root_DragLeave"
        Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="0" />
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Native caption regions cover header whitespace; visible command buttons receive input. -->
        <Grid x:Name="ShellHeader" Padding="12,0,148,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TitleBar" Background="Transparent" MinWidth="108" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Image Source="ms-appx:///Assets/CAD2NC.png" Width="26" Height="26" AutomationProperties.Name="CAD2NC" />
                    <TextBlock x:Name="BrandName" Text="CAD2NC" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="DocumentTitle" Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </Grid>

        <!-- Primary commands keep fixed positions. Less-frequent commands and pages live in overflow. -->
        <Grid
            x:Name="HeaderToolbar"
            Grid.Column="1"
            Padding="0"
            Background="Transparent">
            <CommandBar
                x:Name="MainCommands"
                Height="44"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True">
                <AppBarButton
                    x:Name="OpenCadButton"
                    AutomationProperties.AutomationId="OpenCadButton"
                    Icon="OpenFile"
                    Label="打开文件"
                    Click="OpenCad_Click"
                    Style="{StaticResource SecondaryCommandBarButtonStyle}"
                    ToolTipService.ToolTip="打开 DWG / DXF / NC（Ctrl+O）" />
                <AppBarButton
                    x:Name="SaveButton"
                    AutomationProperties.AutomationId="SaveButton"
                    Icon="Save"
                    Label="保存任务"
                    Click="Save_Click"
                    Style="{StaticResource SecondaryCommandBarButtonStyle}"
                    ToolTipService.ToolTip="保存加工设置和轮廓选择（Ctrl+S）" />
                <AppBarSeparator />
                <AppBarButton
                    x:Name="GenerateButton"
                    AutomationProperties.AutomationId="GenerateButton"
                    Icon="Play"
                    Label="生成刀路"
                    Click="Generate_Click"
                    Style="{StaticResource PrimaryCommandBarButtonStyle}"
                    ToolTipService.ToolTip="根据当前参数生成刀路（F5）" />
                <AppBarButton
                    x:Name="ExportButton"
                    AutomationProperties.AutomationId="ExportButton"
                    Icon="SaveLocal"
                    Label="导出 NC"
                    Click="Export_Click"
                    Style="{StaticResource SecondaryCommandBarButtonStyle}" />
                <AppBarButton
                    x:Name="PrintLabelButton"
                    AutomationProperties.AutomationId="PrintLabelButton"
                    Icon="Print"
                    Label="打印标签"
                    Click="PrintLabel_Click"
                    Style="{StaticResource SecondaryCommandBarButtonStyle}"
                    ToolTipService.ToolTip="打印 60×40 mm 母板标签" />
                <AppBarButton
                    x:Name="CancelButton"
                    AutomationProperties.AutomationId="CancelButton"
                    Icon="Cancel"
                    Label="取消计算"
                    Click="Cancel_Click"
                    Visibility="Collapsed"
                    Style="{StaticResource SecondaryCommandBarButtonStyle}" />
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Name="UndoButton" Icon="Undo" Label="撤销" Click="Undo_Click" />
                    <AppBarButton x:Name="RedoButton" Icon="Redo" Label="重做" Click="Redo_Click" />
                    <AppBarSeparator />
                    <AppBarButton Icon="OpenPane" Label="打开加工任务" Click="OpenTask_Click" />
                    <AppBarButton Icon="Clock" Label="最近">
                        <AppBarButton.Flyout>
                            <MenuFlyout x:Name="RecentMenu" Opening="RecentMenu_Opening" />
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarButton x:Name="SaveAsButton" Icon="SaveLocal" Label="加工任务另存为…" Click="SaveAs_Click" />
                    <AppBarButton x:Name="ExportAsButton" Icon="SaveLocal" Label="机床程序另存为…" Click="ExportAs_Click" />
                    <AppBarButton x:Name="BatchExportButton" Icon="SaveLocal" Label="按母板批量导出 NC" Click="BatchExport_Click" />
                    <AppBarSeparator />
                    <AppBarButton
                        x:Name="GuideMenuButton"
                        AutomationProperties.AutomationId="GuideMenuButton"
                        Icon="Help"
                        Label="说明"
                        Click="GuideMenu_Click" />
                    <AppBarButton
                        x:Name="SettingsMenuButton"
                        AutomationProperties.AutomationId="SettingsMenuButton"
                        Icon="Setting"
                        Label="设置"
                        Click="SettingsMenu_Click" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        </Grid>

        <!-- One task context bar: file, scope, result, diagnostics, and next action. -->
        <Border
            x:Name="WorkbenchContextBar"
            AutomationProperties.AutomationId="WorkbenchContextBar"
            AutomationProperties.AccessibilityView="Content"
            AutomationProperties.Name="任务状态"
            Grid.Row="2"
            Padding="16,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,1">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="FileHeading"
                    Text="准备新的加工任务"
                    FontSize="14"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel
                    x:Name="SelectionHeader"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="5">
                    <TextBlock Text="参与加工" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="SelectionSummary" Text="— / — 个轮廓" Style="{StaticResource ContextValueStyle}" />
                </StackPanel>
                <StackPanel x:Name="ResultContextHeader" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                    <TextBlock Text="当前结果" Style="{StaticResource SectionLabel}" />
                    <TextBlock
                        x:Name="ResultSummary"
                        Text="等待文件"
                        Style="{StaticResource ContextValueStyle}"
                        AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <TextBlock
                    x:Name="NextActionText"
                    Grid.Column="3"
                    MaxWidth="300"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource ContextValueStyle}" />
                <Button
                    x:Name="DiagnosticBadgeButton"
                    Grid.Column="4"
                    Content="查看诊断"
                    Click="ShowResults_Click"
                    Visibility="Collapsed"
                    Style="{StaticResource StatusBadgeButtonStyle}"
                    AutomationProperties.AutomationId="DiagnosticBadgeButton" />
                <Button
                    x:Name="OpenResultsButton"
                    Grid.Column="5"
                    Content="查看结果"
                    Click="ShowResults_Click"
                    Style="{StaticResource StatusBadgeButtonStyle}"
                    AutomationProperties.AutomationId="OpenResultsButton" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="12,6,12,0" Spacing="4">
            <InfoBar
                x:Name="Notice"
                IsOpen="False"
                IsClosable="True"
                Severity="Informational" />
        </StackPanel>

        <Grid
            x:Name="WorkbenchSurface"
            Grid.Row="4"
            Margin="{StaticResource WorkbenchShellMargin}"
            RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Only shown below 900 DIP. Exactly one item is checked by ApplyView. -->
            <Grid
                x:Name="CompactNavigation"
                HorizontalAlignment="Center"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="CompactNavigation"
                AutomationProperties.AccessibilityView="Content"
                AutomationProperties.Name="工作区视图">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ToggleButton
                        x:Name="PreviewPanelButton"
                        Content="预览"
                        Click="ShowPreview_Click"
                        Style="{StaticResource CompactToggleButtonStyle}" />
                    <ToggleButton
                        x:Name="ContoursPanelButton"
                        Content="轮廓"
                        Click="ShowContours_Click"
                        Style="{StaticResource CompactToggleButtonStyle}" />
                    <ToggleButton
                        x:Name="ParametersPanelButton"
                        Content="参数"
                        Click="ShowParameters_Click"
                        Style="{StaticResource CompactToggleButtonStyle}" />
                    <ToggleButton
                        x:Name="ResultsPanelButton"
                        Content="结果"
                        Click="ShowResults_Click"
                        Style="{StaticResource CompactToggleButtonStyle}" />
                </StackPanel>
            </Grid>

            <Grid
                x:Name="WorkArea"
                Grid.Row="1"
                ColumnSpacing="8"
                SizeChanged="WorkArea_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="MainViewRow" Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="ResultsRow" Height="0" />
                    <RowDefinition x:Name="ResultStripRow" Height="36" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="240" MinWidth="0" />
                    <ColumnDefinition x:Name="CanvasColumn" Width="*" MinWidth="0" />
                    <ColumnDefinition x:Name="RightColumn" Width="320" MinWidth="0" />
                </Grid.ColumnDefinitions>

                <!-- Contour identity, machining inclusion and viewing selection stay separate. -->
                <Border x:Name="LeftPanel" Grid.RowSpan="4" Style="{StaticResource WorkbenchPanelStyle}"
                    AutomationProperties.AutomationId="LeftPanel" AutomationProperties.AccessibilityView="Content" AutomationProperties.Name="图纸轮廓面板">
                    <Grid Padding="10" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="图纸轮廓" Style="{StaticResource PanelHeadingStyle}" />
                            <Button HorizontalAlignment="Right" Click="ToggleLeft_Click" Style="{StaticResource CompactIconButtonStyle}"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="收起轮廓面板" AutomationProperties.Name="收起轮廓面板">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            </Button>
                        </Grid>
                        <AutoSuggestBox x:Name="ContourSearch" Grid.Row="1" MinHeight="32" PlaceholderText="搜索编号或图层" QueryIcon="Find" TextChanged="Search_TextChanged" />
                        <ComboBox x:Name="LayerFilter" Grid.Row="2" MinHeight="30" HorizontalAlignment="Stretch" PlaceholderText="全部图层" SelectionChanged="LayerFilter_SelectionChanged" />
                        <Grid Grid.Row="3" ColumnSpacing="5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ToggleButton x:Name="ContourAllToggle" Content="全部" IsChecked="True" Click="ContourMode_Click" HorizontalAlignment="Stretch" Style="{StaticResource CompactToggleButtonStyle}" />
                            <ToggleButton x:Name="ContourOrderToggle" Grid.Column="1" Content="加工顺序" Click="ContourMode_Click" HorizontalAlignment="Stretch" Style="{StaticResource CompactToggleButtonStyle}" AutomationProperties.AutomationId="ContourOrderToggle" />
                        </Grid>
                        <ListView x:Name="ContourList" Grid.Row="4" MinHeight="64" HorizontalContentAlignment="Stretch" SelectionMode="Extended"
                            SelectionChanged="ContourList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ContourList">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem"><Setter Property="MinHeight" Value="64" /><Setter Property="Padding" Value="2,4" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <CheckBox MinWidth="0" VerticalAlignment="Center" IsChecked="{Binding IsIncluded, Mode=TwoWay}" ToolTipService.ToolTip="参与加工" AutomationProperties.Name="参与加工" />
                                        <controls:ContourThumbnail Grid.Column="1" Contour="{Binding Contour}" Width="40" Height="40" VerticalAlignment="Center" IsHitTestVisible="False" />
                                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Id}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Side, Converter={StaticResource CutSideLabelConverter}}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                            <TextBlock Text="{Binding SizeText}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Layer}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding ToolpathOrderText}" FontSize="10" Foreground="{StaticResource CanvasAccentBrush}" />
                                            </Grid>
                                            <TextBlock Text="{Binding IsOuterCandidate, Converter={StaticResource StockLabelConverter}}" FontSize="10" Foreground="#AD782C" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Border x:Name="ContourSelectionDetails" Grid.Row="5" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Visibility="Collapsed">
                            <ScrollViewer x:Name="ContourDetailScroll" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto"
                                AutomationProperties.AutomationId="ContourDetailScroll" AutomationProperties.AccessibilityView="Content" AutomationProperties.Name="选中轮廓详情">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="SelectedContourHeading" FontSize="13" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="SelectedOutsideButton" Content="外侧 · 零件" Click="SetOutside_Click" HorizontalAlignment="Stretch" Style="{StaticResource CompactToggleButtonStyle}" AutomationProperties.AutomationId="SelectedOutsideButton" />
                                    <ToggleButton x:Name="SelectedInsideButton" Grid.Column="1" Content="内侧 · 孔" Click="SetInside_Click" HorizontalAlignment="Stretch" Style="{StaticResource CompactToggleButtonStyle}" AutomationProperties.AutomationId="SelectedInsideButton" />
                                </Grid>
                                <TextBlock x:Name="SelectedSideSummary" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <controls:MachiningSideDiagram x:Name="SelectedSideDiagram" HorizontalAlignment="Stretch" />
                                <Button Content="定位选中轮廓" Click="LocateSelection_Click" Style="{StaticResource CompactButtonStyle}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <StackPanel Grid.Row="6" Spacing="5">
                            <TextBlock x:Name="ContourSelectionSummary" Text="选中 0 · 加工 0 / 0" FontSize="11" AutomationProperties.AutomationId="ContourSelectionSummary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ContourCount" Text="勾选参与加工 · Ctrl / Shift 多选" FontSize="10" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button x:Name="VisibleContoursButton" Content="批量操作" HorizontalAlignment="Stretch" Style="{StaticResource CompactButtonStyle}">
                                    <Button.Flyout><MenuFlyout>
                                        <MenuFlyoutItem x:Name="IncludeVisibleMenu" Text="加工全部可见轮廓" Click="IncludeVisible_Click" />
                                        <MenuFlyoutItem x:Name="ExcludeVisibleMenu" Text="不加工全部可见轮廓" Click="ExcludeVisible_Click" />
                                        <MenuFlyoutItem Text="仅加工可见非母板轮廓" Click="IncludeParts_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="OutsideSelectedMenu" Text="选中项设为外侧零件" Click="SetOutside_Click" />
                                        <MenuFlyoutItem x:Name="InsideSelectedMenu" Text="选中项设为内侧孔" Click="SetInside_Click" />
                                    </MenuFlyout></Button.Flyout>
                                </Button>
                                <Button Grid.Column="1" Click="SettingsMenu_Click" Style="{StaticResource CompactIconButtonStyle}" AutomationProperties.Name="设置"><FontIcon Glyph="&#xE713;" FontSize="15" /></Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Canvas -->
                <Border
                    x:Name="CanvasPanel"
                    Grid.Column="1"
                    Background="{StaticResource CanvasSurfaceBrush}"
                    BorderBrush="{StaticResource CanvasStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource WorkbenchCornerRadius}"
                    RequestedTheme="Dark">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Padding="6,3" Background="{StaticResource CanvasToolbarBrush}" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button
                                    x:Name="ShowLeftButton"
                                    Content="轮廓"
                                    Click="ToggleLeft_Click"
                                    Visibility="Collapsed"
                                    Style="{StaticResource CanvasToolbarButtonStyle}" />
                                <Button
                                    Content="适应窗口"
                                    Click="Fit_Click"
                                    Style="{StaticResource CanvasToolbarButtonStyle}"
                                    ToolTipService.ToolTip="适应窗口（F）" />
                                <Button
                                    Click="LocateSelection_Click"
                                    Style="{StaticResource CanvasToolbarButtonStyle}"
                                    ToolTipService.ToolTip="定位选中轮廓"
                                    AutomationProperties.Name="定位选中轮廓">
                                    <FontIcon Glyph="&#xE81E;" FontSize="13" />
                                </Button>
                            </StackPanel>
                            <ProgressRing
                                x:Name="BusyRing"
                                Grid.Column="1"
                                Width="18"
                                Height="18"
                                Margin="6,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                IsActive="False"
                                Foreground="{StaticResource CanvasAccentBrush}" />
                            <Button
                                Grid.Column="2"
                                Content="图层"
                                Style="{StaticResource CanvasToolbarButtonStyle}">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <ToggleMenuFlyoutItem x:Name="SourceToggle" Text="灰 · 原 CAD 轮廓" IsChecked="True" Click="Layers_Changed" />
                                        <ToggleMenuFlyoutItem x:Name="FinishedToggle" Text="绿 · 成品切边" IsChecked="True" Click="Layers_Changed" />
                                        <ToggleMenuFlyoutItem x:Name="ToolpathToggle" Text="蓝 · 刀心路线" IsChecked="True" Click="Layers_Changed" />
                                        <ToggleMenuFlyoutItem x:Name="RapidToggle" Text="虚线 · 空移连线" IsChecked="True" Click="Layers_Changed" />
                                        <ToggleMenuFlyoutItem x:Name="DirectionsToggle" Text="箭头 · 方向与顺序" IsChecked="True" Click="Layers_Changed" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button
                                x:Name="ShowRightButton"
                                Grid.Column="3"
                                Content="参数"
                                Click="ToggleRight_Click"
                                Visibility="Collapsed"
                                Style="{StaticResource CanvasToolbarButtonStyle}" />
                        </Grid>
                        <controls:CadCanvas x:Name="Preview" Grid.Row="1" />
                        <Border x:Name="StalePlanBadge" Grid.Row="1" Margin="12" Padding="10,5" Background="#E6352C20"
                            BorderBrush="#B28A46" BorderThickness="1" CornerRadius="4" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="Collapsed" IsHitTestVisible="False"
                            AutomationProperties.AutomationId="StalePlanBadge" AutomationProperties.AccessibilityView="Content" AutomationProperties.Name="上次结果 · 待更新">
                            <TextBlock Text="上次结果 · 待更新" Foreground="#F1CB86" FontSize="12" />
                        </Border>
                        <StackPanel x:Name="CanvasLegend" Grid.Row="1" Orientation="Horizontal" Spacing="3" Margin="10,0,10,8" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                            <ToggleButton x:Name="SourceLegend" Content="┄ 原图" Tag="Source" Click="Legend_Click" Style="{StaticResource CanvasLegendStyle}" Foreground="#A9B7C5" />
                            <ToggleButton x:Name="FinishedLegend" Content="─ 成品边" Tag="Finished" Click="Legend_Click" Style="{StaticResource CanvasLegendStyle}" Foreground="#79BEA7" />
                            <ToggleButton x:Name="ToolpathLegend" Content="─ 刀心" Tag="Toolpath" Click="Legend_Click" Style="{StaticResource CanvasLegendStyle}" Foreground="#4ABBF9" />
                            <ToggleButton x:Name="RapidLegend" Content="┄ 空移" Tag="Rapid" Click="Legend_Click" Style="{StaticResource CanvasLegendStyle}" Foreground="#E8BB72" />
                            <ToggleButton x:Name="DirectionsLegend" Content="→ 方向" Tag="Directions" Click="Legend_Click" Style="{StaticResource CanvasLegendStyle}" />
                        </StackPanel>
                        <Border x:Name="EmptyCanvas" Grid.Row="1" Background="{StaticResource CanvasSurfaceBrush}">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <StackPanel
                                    MaxWidth="520"
                                    Padding="24"
                                    Spacing="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <TextBlock Text="打开文件，开始工作" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="拖入 DWG、DXF 或 NC 文件，或从下面选择。"
                                        Foreground="{StaticResource CanvasSecondaryTextBrush}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Content="打开 DWG / DXF / NC"
                                        Click="OpenCad_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        MinHeight="36" />
                                    <Button
                                        Content="继续已保存的加工任务"
                                        Click="OpenTask_Click"
                                        MinHeight="36" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border
                            x:Name="PlaybackBar"
                            Grid.Row="2"
                            Padding="8,4"
                            Background="{StaticResource CanvasPlaybackBrush}">
                            <Grid RowSpacing="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="22" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="PlaybackButton"
                                        Content="播放"
                                        IsEnabled="False"
                                        Click="Playback_Click"
                                        Style="{StaticResource CanvasToolbarButtonStyle}"
                                        AutomationProperties.Name="播放 NC" />
                                    <Button
                                        x:Name="PlaybackResetButton"
                                        Grid.Column="1"
                                        Content="复位"
                                        IsEnabled="False"
                                        Click="PlaybackReset_Click"
                                        Style="{StaticResource CanvasToolbarButtonStyle}" />
                                    <Slider
                                        x:Name="PlaybackProgress"
                                        Grid.Column="2"
                                        Minimum="0"
                                        Maximum="100"
                                        StepFrequency="0.01"
                                        IsEnabled="False"
                                        VerticalAlignment="Center"
                                        ValueChanged="PlaybackProgress_Changed"
                                        AutomationProperties.Name="NC 播放进度" />
                                    <ComboBox
                                        x:Name="PlaybackSpeed"
                                        Grid.Column="3"
                                        MinWidth="70"
                                        MinHeight="30"
                                        Padding="7,1"
                                        SelectedIndex="5"
                                        SelectionChanged="PlaybackSpeed_Changed"
                                        AutomationProperties.Name="播放速度">
                                        <ComboBoxItem Content="0.25×" />
                                        <ComboBoxItem Content="0.5×" />
                                        <ComboBoxItem Content="1×" />
                                        <ComboBoxItem Content="2×" />
                                        <ComboBoxItem Content="5×" />
                                        <ComboBoxItem Content="10×" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock
                                    x:Name="PlaybackStatusText"
                                    Grid.Row="1"
                                    Text=""
                                    FontSize="12"
                                    Foreground="{StaticResource CanvasSecondaryTextBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Parameters -->
                <Border x:Name="RightPanel" Grid.Column="2" Grid.RowSpan="4" Style="{StaticResource WorkbenchPanelStyle}"
