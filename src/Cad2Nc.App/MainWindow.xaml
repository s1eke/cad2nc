<Expander x:Name="DirectionParametersExpander" AutomationProperties.AutomationId="DirectionParametersExpander" Header="补偿与方向" IsExpanded="False" Style="{StaticResource WorkbenchExpanderStyle}"><StackPanel><Grid ColumnSpacing="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
