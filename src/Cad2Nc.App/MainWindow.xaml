<Expander x:Name="ToolParametersExpander" AutomationProperties.AutomationId="ToolParametersExpander" Header="刀具" IsExpanded="False" Style="{StaticResource WorkbenchExpanderStyle}"><StackPanel><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid ColumnSpacing="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
